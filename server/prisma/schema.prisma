generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum UserRole {
  DEVELOPER
  MASTER
  ADMIN
  BRANCH
  USER
}

enum UserStatus {
  ONLINE
  BUSY
  OFFLINE
}

enum UserPermission {
  READ
  CREATE
  UPDATE
  DELETE
}

enum StatusType {
  TEXT
  IMAGE
  VIDEO
}

enum MediaStatus {
  PENDING
  COMPLETED
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  FILE
  STICKER
}

// --- Models ---

model Otp {
  id    String @id @default(uuid())
  phone String @unique
  code  String

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otps")
}

model User {
  id           String @id @default(uuid())
  guid         String @unique @default(uuid())
  name         String
  phone        String @unique
  passwordHash String
  sessions  Session[]

  email     String?
  location  String?
  avatarUrl String?
  status    UserStatus @default(OFFLINE)
  lastSeen  DateTime   @default(now())
  ipAddress String     @default("0.0.0.0")
  isActive  Boolean    @default(false)

  role       UserRole         @default(USER)
  permission UserPermission[] @default([READ])

  parentId String?
  parent   User?   @relation("UserHierarchy", fields: [parentId], references: [id])
  children User[]  @relation("UserHierarchy")

  members         ChatMember[]
  messages        Message[]        @relation("SentMessages")
  medias          Media[]
  statuses        Status[]
  statusViews     StatusView[]
  cannedResponses CannedResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  systems   System[]

  @@index([guid, name, phone])
  @@map("users")
}

model Session {
  id                 String   @id @default(uuid())

  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash   String   @unique // Hash of refresh token not the token itself
  tokenVersion       Int      @default(0) // Helps detect token reuse / rotation attacks

  expiresAt          DateTime // Expiry of refresh token
 
  ipAddress          String? // IP address of the client - can be used to detect geolocation
  userAgent          String? // User agent of the client - can be used to detect bots
  deviceInfo         String?  // Device info of the client - detects browser, OS, etc
 
  isRevoked          Boolean  @default(false) // Session has been revoked
  revokedAt          DateTime? // When the session was revoked

  createdAt          DateTime @default(now()) // When the session was created
  updatedAt          DateTime @updatedAt // Last time the session was updated

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Chat {
  id         String  @id @default(uuid())
  isGroup    Boolean @default(false)
  groupName  String?
  groupImage String?

  members  ChatMember[]
  messages Message[]

  lastMessageId String?  @unique
  lastMessage   Message? @relation("LastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chats")
}

model ChatMember {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  unreadCount Int      @default(0)
  isPinned    Boolean  @default(false)
  isMuted     Boolean  @default(false)
  isArchived  Boolean  @default(false)
  joinedAt    DateTime @default(now())

  @@unique([userId, chatId])
  @@map("chat_members")
}

model Message {
  id      String      @id @default(uuid())
  type    MessageType @default(TEXT)
  content String      @db.Text

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  chatId   String
  chat     Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  fileUrl  String?
  fileName String?
  fileSize String?
  duration Int?
  mimeType String?

  replyToId        String?
  forwardedFromId  String?
  originalSenderId String?
  isEdited  Boolean @default(false)
  isDeleted Boolean @default(false)
  reactions Json?

  asLastMessage Chat? @relation("LastMessage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId, createdAt])
  @@map("messages")
}

model Status {
  id      String     @id @default(uuid())
  type    StatusType @default(TEXT)
  content String?
  color   String?

  mediaId String? @unique
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  viewers StatusView[]

  expiresAt DateTime @default(dbgenerated("(NOW() + interval '24 hours')"))
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("statuses")
}

model StatusView {
  id       String @id @default(uuid())
  statusId String
  status   Status @relation(fields: [statusId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([statusId, userId])
  @@map("status_views")
}

model Media {
  id           String      @id @default(uuid())
  fileKey      String      @unique
  originalName String
  mimeType     String
  mediaStatus  MediaStatus @default(PENDING)
  fileSize     Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status Status?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileKey])
  @@index([userId])
  @@map("media")
}

model CannedResponse {
  id          String  @id @default(uuid())
  command     String
  text        String
  description String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, command])
  @@map("canned_responses")
}

model System {
  id String @id @default(uuid())

  activeBranchId String?
  activeBranch   User?   @relation(fields: [activeBranchId], references: [id])

  workspaceName     String?
  systemVersion       String?
  systemEmail       String?
  systemPhone       String?

  systemTimezone    String?
  systemLanguage    String?
  systemMaintenance Boolean?

  updatedAt DateTime @updatedAt

  @@map("system")
}

